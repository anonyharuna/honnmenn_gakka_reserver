# 申请人信息，和网站上填写的一致
# 姓名（全角），例：ＹＡＭＡＭＯＴＯ
RES_NAME=
# 电话，例：09012345678
RES_PHONE=
# 生日 YYYYMMDD，例：20000101
RES_BIRTHDAY=
# 毕业番号（全角），例：１２３４５６７８
RES_GRACER_NO=

# 1 = 自动预约 / 改约，0 = 只发通知
AUTO_BOOK=1
COURSE=11
# 考场（250 江東 / 270 府中 / 280 鮫洲），同一天越靠前越优先
PLACES=250,270,280
# 可选：预约范围（YYYY-MM-DD），默认从明天起往后约 3 个月
DATE_FROM=
DATE_TO=
# 同一天优先下午（1）或上午（0）
PREFER_PM=1
# 实时查询间隔（秒），太快会被 403 限流
REQ_INTERVAL=3
CAL_REFRESH=300

# 邮件通知（可选，SMTP_USER 留空则只写日志）
# Gmail 需开两步验证后创建应用专用密码：https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=
